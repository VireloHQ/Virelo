{
  "name": "virelo",
  "version": "0.4.0",
  "description": "Turn any folder into a private, streaming-style video library.",
  "type": "module",
  "bin": {
    "virelo": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run clean && npm run build:server && npm run build:web",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "i18n:check": "node scripts/check-i18n.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "npm run build:server && node --watch dist/cli.js --no-open",
    "prepublishOnly": "npm run check",
    "pack:check": "npm pack --dry-run",
    "audit:package": "node scripts/audit-package.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=4 tests/*.test.mjs",
    "check": "npm run build && npm run typecheck:web && npm test && npm run pack:check"
  },
  "keywords": [
    "self-hosted",
    "media-server",
    "virelo",
    "video",
    "streaming",
    "media-library",
    "npx"
  ],
  "author": "Riyoway",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VireloHQ/Virelo.git"
  },
  "bugs": {
    "url": "https://github.com/VireloHQ/Virelo/issues"
  },
  "homepage": "https://github.com/VireloHQ/Virelo#readme",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "chokidar": "^6.0.0",
    "fastify": "^5.10.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "hls.js": "^1.6.16",
    "jsqr": "1.4.0",
    "playwright": "1.64.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.8",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "zustand": "^5.0.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
