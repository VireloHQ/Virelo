{
  "name": "virelo-workspace",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "npm run build -w apps/server && npm run build -w apps/web",
    "check": "npm run check -w apps/server && npm run check -w apps/web",
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run dev:server -w apps/server",
    "i18n:check": "npm run i18n:check --workspaces --if-present",
    "pack:release": "npm run pack:release -w apps/server",
    "audit:package": "npm run audit:package -w apps/server",
    "deploy:web": "wrangler deploy --config apps/web/wrangler.jsonc",
    "preview:web": "wrangler preview --config apps/web/wrangler.jsonc",
    "verify:web": "npm run verify:deployment -w apps/web"
  },
  "devDependencies": {
    "wrangler": "4.153.0"
  },
  "overrides": {
    "glob": "14.0.4"
  }
}
